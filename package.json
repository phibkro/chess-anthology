{
  "name": "chess-anthology",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "pnpm compile:stories && vp build",
    "preview": "vp preview",
    "prepare": "vp config --no-agent",
    "check": "vp check",
    "format": "vp fmt",
    "test": "vp test run",
    "check:duplicates": "jscpd src",
    "check:unused": "knip",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:all": "pnpm check && pnpm test && pnpm check:duplicates && pnpm check:unused && pnpm check:compiler && pnpm build",
    "precommit": "pnpm check && pnpm test && pnpm check:duplicates && pnpm check:unused && node scripts/secret-scan.mjs staged && pnpm check:compiler",
    "setup:secrets": "node scripts/install-gitleaks.mjs",
    "commitlint": "commitlint",
    "index:albums": "node scripts/index-albums.mjs",
    "check:compiler": "pnpm --dir prototypes/chess-compiler check && pnpm --dir prototypes/chess-compiler test && pnpm --dir prototypes/chess-compiler run eval",
    "compile:stories": "node --import tsx scripts/compile-stories.mts",
    "predev": "pnpm compile:stories"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.5.0",
    "@xstate/store": "^4.3.0",
    "chessops": "0.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@shadcn/lint": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "chess-compiler-prototype": "link:prototypes/chess-compiler",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "~7.0.2",
    "ultracite": "8.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.16.1"
}
