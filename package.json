{
  "name": "chess-anthology",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "bun --bun node_modules/vite-plus/bin/vp dev",
    "build": "pnpm compile:stories && bun --bun node_modules/vite-plus/bin/vp build",
    "preview": "bun --bun node_modules/vite-plus/bin/vp preview",
    "prepare": "bun --bun node_modules/vite-plus/bin/vp config --no-agent",
    "check": "bun --bun node_modules/vite-plus/bin/vp check",
    "format": "bun --bun node_modules/vite-plus/bin/vp fmt",
    "test": "bun test ./src/lesson/lesson.test.ts ./src/story/story.test.ts",
    "check:duplicates": "bun --bun node_modules/jscpd/run-jscpd.js src",
    "check:unused": "bun --bun node_modules/knip/bin/knip-bun.js",
    "check:secrets": "bun scripts/secret-scan.mts",
    "check:all": "pnpm check && pnpm test && pnpm check:duplicates && pnpm check:unused && pnpm check:compiler && pnpm check:lsp && pnpm check:runtime-inference && pnpm build",
    "precommit": "pnpm check && pnpm test && pnpm check:duplicates && pnpm check:unused && bun scripts/secret-scan.mts staged && pnpm check:compiler",
    "setup:secrets": "bun scripts/install-gitleaks.mts",
    "commitlint": "bun --bun node_modules/@commitlint/cli/cli.js",
    "index:albums": "bun scripts/index-albums.mts",
    "check:compiler": "pnpm --dir compiler check:schemas && pnpm --dir compiler check && pnpm --dir compiler test && pnpm --dir compiler run eval",
    "compile:stories": "bun scripts/compile-stories.mts",
    "predev": "pnpm compile:stories",
    "check:runtime-inference": "python3 compiler/evaluation/runtime_compare.py --self-test && python3 compiler/evaluation/execution_modes.py --self-test",
    "check:lsp": "python3 compiler/evaluation/lsp_smoke.py"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.5.0",
    "@xstate/store": "^4.3.0",
    "chessops": "0.15.1",
    "mdast-util-to-markdown": "2.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@chess-anthology/compiler": "link:compiler",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@shadcn/lint": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "ultracite": "8.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "pnpm@12.16.1"
}
