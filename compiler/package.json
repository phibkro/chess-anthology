{
  "name": "@chess-anthology/compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/compiler/index.ts",
    "./playback": "./src/contracts/playback.ts",
    "./sources": "./src/sources/index.ts"
  },
  "scripts": {
    "generate": "bun --bun node_modules/langium-cli/bin/langium.js generate",
    "demo": "bun src/adapters/demo.ts",
    "lsp": "bun src/adapters/lsp.ts --stdio",
    "check": "bun --bun node_modules/typescript/bin/tsc --noEmit",
    "compile": "bun src/adapters/cli.ts",
    "test": "bun test src/seams.test.ts src/chess960.test.ts src/runtime/source-cache.test.ts src/sources/sources.test.ts",
    "eval": "bun evaluation/evaluate.mts",
    "bench": "bun evaluation/benchmark.mts"
  },
  "dependencies": {
    "chessops": "0.15.1",
    "langium": "4.4.0",
    "valibot": "1.5.0",
    "vscode-languageserver": "10.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "fast-check": "4.10.2",
    "langium-cli": "4.4.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "pnpm@12.16.1"
}
